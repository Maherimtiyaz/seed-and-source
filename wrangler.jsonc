// Cloudflare Worker config. "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "seed-n-source",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Keep the variables you set in the dashboard (Settings → Variables and Secrets) on every deploy.
  "keep_vars": true
}
